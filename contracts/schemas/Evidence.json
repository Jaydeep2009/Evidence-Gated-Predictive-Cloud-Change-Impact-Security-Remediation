{
  "$defs": {
    "Classification": {
      "description": "How the evidence was obtained.",
      "enum": [
        "observed",
        "inferred",
        "verified"
      ],
      "title": "Classification",
      "type": "string"
    },
    "EvidenceType": {
      "description": "Source type of evidence.",
      "enum": [
        "infrastructure",
        "application",
        "runtime"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "Provenance": {
      "description": "Detailed provenance information for an evidence item.",
      "properties": {
        "source_type": {
          "enum": [
            "file",
            "cluster",
            "trace",
            "log",
            "probe",
            "audit",
            "iac_plan",
            "manual"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        },
        "line_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Number"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "content_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "extractor": {
          "title": "Extractor",
          "type": "string"
        },
        "extractor_version": {
          "default": "1.0.0",
          "title": "Extractor Version",
          "type": "string"
        },
        "extracted_at": {
          "format": "date-time",
          "title": "Extracted At",
          "type": "string"
        }
      },
      "required": [
        "source_type",
        "source_path",
        "extractor",
        "extracted_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Relationship": {
      "description": "Types of relationships between nodes in the evidence graph.",
      "enum": [
        "DEPENDS_ON",
        "CALLS",
        "CONNECTS_TO",
        "FAILED_TO_CONNECT",
        "OBSERVED_COMMUNICATION",
        "READINESS_COUPLED",
        "ALLOWS",
        "DENIES",
        "SELECTS",
        "EXPOSES",
        "DEPLOYED_AS",
        "CONFIGURED_BY",
        "RUNS_AS",
        "HAS_PERMISSION",
        "NEEDS_PERMISSION"
      ],
      "title": "Relationship",
      "type": "string"
    }
  },
  "description": "A single piece of evidence about a relationship between nodes.",
  "properties": {
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "evidence_type": {
      "$ref": "#/$defs/EvidenceType"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "subject": {
      "title": "Subject",
      "type": "string"
    },
    "relationship": {
      "$ref": "#/$defs/Relationship"
    },
    "object": {
      "title": "Object",
      "type": "string"
    },
    "polarity": {
      "default": "supports",
      "enum": [
        "supports",
        "refutes"
      ],
      "title": "Polarity",
      "type": "string"
    },
    "classification": {
      "$ref": "#/$defs/Classification"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "evidence_id",
    "evidence_type",
    "source",
    "subject",
    "relationship",
    "object",
    "classification",
    "confidence",
    "observed_at",
    "snapshot_id",
    "provenance"
  ],
  "title": "Evidence",
  "type": "object"
}